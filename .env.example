# Database MongoDB Connection String (Wajib untuk Vercel Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/educlass?retryWrites=true&w=majority

# Optional: Initial Admin Seed Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_NAME=Administrator
